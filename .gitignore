.Rproj.user
.Rhistory
.RData
.Ruserdata
.gapfill_checkpoint.csv
.gapfill.log
.backfill*.log

# python artifacts
__pycache__/
*.pyc
.omc/

# model-dataset trees commit parquet only; csv/rds are release-asset staging
mlb/*/csv/
mlb/*/rds/
# NCAA release staging: the builder writes csv.gz/rds here only when
# release=True, and python/ncaa_baseball_data_build/io.py already DOCUMENTS
# this path as gitignored -- it just never was. 732M of derivable staging was
# sitting untracked, one blind `git add` from being committed.
ncaa/_release_build/
# MLB publish sentinels (zero-byte .done_* markers). csv.gz/rds are NOT here:
# they are built into a tempdir and deleted the moment the upload finishes --
# only parquet ever exists on disk.
mlb/_publish_state/
.publish_tmp_*/
*.out

# Stray root logs only (D8: top-level *.log/*.out never belong in git).
# NOTE: `logs/` is deliberately NOT ignored (D22: run logs are tracked in
# every repo) -- the NCAA raw twins track theirs, and this repo's backfill
# shards are the only record of which season/shard did what.
# `*.out` above is left UNANCHORED, i.e. stricter than D8's `/*.out`: nothing
# in this tree writes a .out today, so anchoring it would only widen what can
# be committed by accident.
/*.log
